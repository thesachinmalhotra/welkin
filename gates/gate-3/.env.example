# Welkin Gate 3 — environment template.
# Copy to `.env` and fill for your target. docker compose auto-loads `.env`
# from this directory. NO secrets are committed; this file is example-only.

# --- Collector -> OpenMeter (Economic Plane) ---
# self-hosted (local quickstart):
OPENMETER_URL=http://openmeter:8888
OPENMETER_TOKEN=
# managed / SaaS OpenMeter:
# OPENMETER_URL=https://openmeter.cloud
# OPENMETER_TOKEN=om_xxx

# --- Kafka: Collector fans out here; Archive consumes from here ---
KAFKA_BROKERS=kafka:9092

# --- Archive Plane object storage (any S3-compatible) ---
# local MinIO:
ARCHIVE_BUCKET=welkin-archive
ARCHIVE_ENDPOINT=http://minio:9000
ARCHIVE_FORCE_PATH_STYLE=true
ARCHIVE_REGION=us-east-1
ARCHIVE_ACCESS_KEY=minioadmin
ARCHIVE_SECRET_KEY=minioadmin

# Cloudflare R2 example (uncomment + set real creds):
# ARCHIVE_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# ARCHIVE_BUCKET=welkin-archive
# ARCHIVE_REGION=auto
# ARCHIVE_FORCE_PATH_STYLE=true
# ARCHIVE_ACCESS_KEY=<r2-access-key>
# ARCHIVE_SECRET_KEY=<r2-secret>
